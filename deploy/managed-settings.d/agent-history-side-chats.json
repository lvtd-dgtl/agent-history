{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/agent-history/side_chat_capture.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /usr/local/lib/agent-history/side_chat_capture.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

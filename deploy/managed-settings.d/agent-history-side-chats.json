{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -r /usr/local/lib/agent-history/side_chat_capture.py ] && python3 -I /usr/local/lib/agent-history/side_chat_capture.py >/dev/null 2>&1; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -r /usr/local/lib/agent-history/side_chat_capture.py ] && python3 -I /usr/local/lib/agent-history/side_chat_capture.py >/dev/null 2>&1; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
